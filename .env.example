# Telegram Bot
BOT_TOKEN=123456:replace_me
# 客服回复投递通道：默认绕过 aiogram，直接调用 Telegram Bot API HTTP。
# 自建 telegram-bot-api 时可改为 http://telegram-bot-api:8081
BOT_API_BASE_URL=https://api.telegram.org
SUPPORT_DELIVERY_MODE=direct_http
SUPPORT_DIRECT_API_TIMEOUT_SECONDS=15
SUPPORT_DELIVERY_FALLBACK_TO_AIOGRAM=true
# 客服入口：默认使用众筹机器人内置私聊客服桥。
# 用户点「联系小掌柜」后进入本机器人客服对话，消息直接同步到 SUPPORT_ADMIN_ID 的私聊。
# 审核群退款/报销/提现卡片可点“切到用户对话”，机器人会在管理员私聊保持当前用户。
# SUPPORT_ADMIN_ID=0 时使用 ADMIN_IDS 的第一个管理员；管理员必须先打开过本机器人。
SUPPORT_ADMIN_ID=0
SUPPORT_PRIVATE_BRIDGE_ENABLED=true
# SUPPORT_EXTERNAL_ONLY=true 仅作为应急外部客服模式，默认不要开启。
SUPPORT_EXTERNAL_ONLY=false
SUPPORT_BOT_USERNAME=@jingpinhybot
SUPPORT_BOT_START_PREFIX=cf
ADMIN_GROUP_ID=-1001234567890
PUBLIC_CHANNEL_ID=-1001234567891
MEMBER_GROUP_ID=-1001234567892
# 会员群整库购买支付链接：包含目前已发布及未来完成的众筹项目资源。
MEMBER_GROUP_PAYMENT_LINK=https://example.com/pay/member-group
ADMIN_IDS=111111111,222222222

# PostgreSQL（生产环境必需）
POSTGRES_DB=crowdfund
POSTGRES_USER=crowdfund
POSTGRES_PASSWORD=change_me_now
DATABASE_URL=postgresql+asyncpg://crowdfund:change_me_now@postgres:5432/crowdfund
AUTO_CREATE_SCHEMA=false
ALLOW_SQLITE_DEV=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SINGLE_INSTANCE_LOCK_KEY=91530001

# Payment / Faka query bridge
PAYMENT_MODE=telethon
FAKA_BOT_USERNAME=faka_bot_username
EXPECTED_FAKA_ORDER_BOT=@jingpinhybot
# 自动监听购买成功通知并验票。这里必须填写实际给商家账号发送“🎉恭喜用户购买成功”消息的机器人。
PAYMENT_AUTO_CONFIRM_ENABLED=true
PAYMENT_CONFIRM_BOT_USERNAME=@jingpinhybot
# 自动监听只接受四种精确商品：拼车单车位30/60元、发起人双车位60/120元；商品内部空格会忽略。
# 其他店铺商品即使含 VP 也不会查单。该关键词保留给底层管理员补单校验。
PAYMENT_EXPECTED_PRODUCT_KEYWORDS=车位支付链接
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELETHON_SESSION=payment_checker
PAYMENT_QUERY_TIMEOUT_SECONDS=25
PAYMENT_AMOUNT_TOLERANCE=0.01
PAYMENT_TEST_MODE=false

# Telegram / Telethon proxy. 国内网络通常需要配置。无需代理则留空。
# 常见本地代理端口：7890 / 7897 / 1080 / 10808
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=7897
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# Business config
# 新发起项目固定可选 30 / 60 元；SEAT_PRICE 只是旧项目/兜底默认值。
SEAT_PRICE=30
CARPOOL_PRICE_30=30
CARPOOL_PRICE_60=60
OPERATION_FEE_RATE=0.15
PAYMENT_FEE_RATE=0.10
PLATFORM_FEE_RATE=0.10
CROWDFUND_EXPIRE_DAYS=7
WISH_ACCEPT_HOURS=3
FUND_LOW_THRESHOLD=300
COCREATE_PLATFORM_RATIO=0.50
COCREATE_PLATFORM_CAP=999999
RESOURCE_UPLOAD_TIMEOUT_HOURS=5

# Temporary channel notices such as payment reservation fallback are auto-deleted after 5 minutes.
TEMP_CHANNEL_NOTICE_DELETE_SECONDS=300
PENDING_ORDER_EXPIRE_MINUTES=30

# 支付链接配置：30 元车位、60 元车位，以及车主预付 2 座对应的 60 / 120 元链接。
CREATOR_PREPAY_SEATS=2
NORMAL_PAYMENT_LINK_30=https://example.com/pay/30
NORMAL_PAYMENT_LINK_60=https://example.com/pay/60
CREATOR_PAYMENT_LINK_60=https://example.com/pay/60
CREATOR_PAYMENT_LINK_120=https://example.com/pay/120
# 旧字段继续保留作 fallback，老部署可不填。
NORMAL_PAYMENT_LINK=https://example.com/pay/30
CREATOR_PAYMENT_LINK=https://example.com/pay/60

# 公开频道按钮深链：启动时会自动从 Telegram 读取真实用户名。此项可留空，仅作为备用。
BOT_USERNAME=

# 冷启动填充模式：只允许管理员/白名单小号使用专属暗号跳过真实支付验票。
# 频道填充完成后请关闭，并更换暗号。
SEED_MODE_ENABLED=false
ADMIN_VERIFY_SECRET=MY_PRIVATE_SEED_CODE_2026
SEEDER_IDS=333333333,444444444

# 发起人双车位虚拟自动核验白名单。
# 只对下面 Telegram 数字 ID 发起的项目生效；审核通过后自动完成 2 个车位预占。
# 不查询 faka、不影响普通乘客支付，资金账本记录 0 元虚拟流水，不计入真实收入。
CREATOR_PREPAY_AUTO_VERIFY_ENABLED=false
CREATOR_PREPAY_AUTO_VERIFY_IDS=111111111,222222222

# 运营稳定增强
PENDING_ORDER_REMINDER_MINUTES=5
DATA_RETENTION_DAYS=30
MESSAGE_PUSH_DELAY_SECONDS=0.05
TELETHON_RECONNECT_ATTEMPTS=3
TELETHON_HEALTHCHECK_SECONDS=60


# 资源与健康检查
RESOURCE_PAGE_SIZE=10
HOT_PROJECT_LIMIT=20
BACKUP_STATUS_FILE=backups/last_backup.txt

# 每日众筹汇总（北京时间）
DAILY_CROWDFUND_SUMMARY_ENABLED=true
DAILY_CROWDFUND_SUMMARY_HOUR=7
DAILY_CROWDFUND_SUMMARY_MINUTE=0
