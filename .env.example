# Telegram Bot
BOT_TOKEN=123456:replace_me
ADMIN_GROUP_ID=-1001234567890
PUBLIC_CHANNEL_ID=-1001234567891
MEMBER_GROUP_ID=-1001234567892
ADMIN_IDS=111111111,222222222

# PostgreSQL（生产环境必需）
POSTGRES_DB=crowdfund
POSTGRES_USER=crowdfund
POSTGRES_PASSWORD=change_me_now
DATABASE_URL=postgresql+asyncpg://crowdfund:change_me_now@postgres:5432/crowdfund
AUTO_CREATE_SCHEMA=false
ALLOW_SQLITE_DEV=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SINGLE_INSTANCE_LOCK_KEY=91530001

# Payment / Faka query bridge
PAYMENT_MODE=telethon
FAKA_BOT_USERNAME=faka_bot_username
EXPECTED_FAKA_ORDER_BOT=@jingpinhybot
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_me
TELETHON_SESSION=payment_checker
PAYMENT_QUERY_TIMEOUT_SECONDS=25
PAYMENT_AMOUNT_TOLERANCE=0.01
PAYMENT_TEST_MODE=false

# Telegram / Telethon proxy. 国内网络通常需要配置。无需代理则留空。
# 常见本地代理端口：7890 / 7897 / 1080 / 10808
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=127.0.0.1
TG_PROXY_PORT=7897
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# Business config
SEAT_PRICE=30
OPERATION_FEE_RATE=0.15
PAYMENT_FEE_RATE=0.10
PLATFORM_FEE_RATE=0.10
CROWDFUND_EXPIRE_DAYS=7
WISH_ACCEPT_HOURS=3
FUND_LOW_THRESHOLD=300
COCREATE_PLATFORM_RATIO=0.50
COCREATE_PLATFORM_CAP=999999
RESOURCE_UPLOAD_TIMEOUT_HOURS=5

# Temporary channel notices such as payment reservation fallback are auto-deleted after 5 minutes.
TEMP_CHANNEL_NOTICE_DELETE_SECONDS=300
PENDING_ORDER_EXPIRE_MINUTES=30

# 支付链接配置：普通用户 30 元，发起人双车位 60 元。可替换成你的发卡链接。
CREATOR_PREPAY_SEATS=2
NORMAL_PAYMENT_LINK=https://example.com/pay/30
CREATOR_PAYMENT_LINK=https://example.com/pay/60

# 公开频道按钮深链：启动时会自动从 Telegram 读取真实用户名。此项可留空，仅作为备用。
BOT_USERNAME=

# 冷启动填充模式：只允许管理员/白名单小号使用专属暗号跳过真实支付验票。
# 频道填充完成后请关闭，并更换暗号。
SEED_MODE_ENABLED=false
ADMIN_VERIFY_SECRET=MY_PRIVATE_SEED_CODE_2026
SEEDER_IDS=333333333,444444444

# 运营稳定增强
PENDING_ORDER_REMINDER_MINUTES=5
DATA_RETENTION_DAYS=30
MESSAGE_PUSH_DELAY_SECONDS=0.05
TELETHON_RECONNECT_ATTEMPTS=3
TELETHON_HEALTHCHECK_SECONDS=60


# 资源与健康检查
RESOURCE_PAGE_SIZE=10
HOT_PROJECT_LIMIT=20
BACKUP_STATUS_FILE=backups/last_backup.txt
